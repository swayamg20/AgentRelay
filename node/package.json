{
	"name": "agentrelay-node",
	"version": "0.0.1",
	"private": true,
	"description": "Owner-controlled local execution boundary for AgentRelay Missions.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=20.18.1"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"agentrelay-node": "dist/bin/agentrelay-node.js",
		"agentrelay-capsule": "dist/bin/agentrelay-capsule.js",
		"agentrelay-codex-guardian": "dist/bin/agentrelay-codex-guardian.js"
	},
	"files": ["dist"],
	"scripts": {
		"prebuild": "pnpm --filter @agentrelay/protocol build",
		"build": "tsc -p tsconfig.json",
		"start": "node dist/bin/agentrelay-node.js run",
		"dev": "tsx src/bin/agentrelay-node.ts",
		"pretest": "pnpm --filter @agentrelay/protocol build",
		"test": "vitest run",
		"test:watch": "vitest",
		"pretypecheck": "pnpm --filter @agentrelay/protocol build",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@agentrelay/protocol": "workspace:*",
		"cac": "^6.7.14",
		"fs-native-extensions": "1.5.0",
		"pino": "^9.5.0",
		"undici": "^7.29.0",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"@openai/codex": "0.146.0",
		"tsx": "4.23.12",
		"typescript": "^7.0.2",
		"vitest": "3.2.6"
	}
}
